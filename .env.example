# Kindle AttentionBoard Configuration
PORT=8787
REFRESH_SECONDS=60

# Display resolution (Default: Kindle Paperwhite 5 / Oasis)
# Paperwhite 3/4: 1072x1448
# Paperwhite 5 / Oasis: 1236x1648
# Kindle Basic: 600x800
KINDLE_WIDTH=1236
KINDLE_HEIGHT=1648

# Band height used by the tile-diff Kindle client (default: 190)
# TILE_HEIGHT=190

# Weather Location (Leave empty for auto-IP detection)
# LATITUDE=10.8231
# LONGITUDE=106.6297
# TIMEZONE=Asia/Ho_Chi_Minh
WEATHER_UNITS=celsius

# Focus Timer defaults (minutes)
FOCUS_WORK_MINUTES=25
FOCUS_BREAK_MINUTES=5
